# ==============================================================================
# api-ai-analytics — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------------------
# Source: Local MongoDB instance (v7+)
#   Install: https://www.mongodb.com/docs/manual/installation/
#   Start: mongod --dbpath ~/.local/share/mongodb/data --fork --port 27017
#   Verify: mongosh --eval "db.runCommand({ping:1})"
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=sentracx_analytics

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
# Source: Local Redis instance
#   Install: sudo apt install redis-server (Linux) / brew install redis (macOS)
#   Verify: redis-cli ping → PONG
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=4005
APP_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# CRM API (SentraCX api-crm)
# ------------------------------------------------------------------------------
# Used for pulling customer/ticket data from the CRM
CRM_API_BASE_URL=https://localhost:5005
CRM_SERVICE_TOKEN=

# ------------------------------------------------------------------------------
# OOS API (br-online-shop api-oos)
# ------------------------------------------------------------------------------
# Used for pulling order/product data for CLV and churn models
# api-oos runs on http://localhost:5004
OOS_API_BASE_URL=http://localhost:5004
OOS_SERVICE_TOKEN=

# ------------------------------------------------------------------------------
# Auth / JWT (internal-auth-service)
# ------------------------------------------------------------------------------
# Source: internal-auth-service (OpenIddict OIDC provider) at https://localhost:5001
# JWT_SECRET: For local dev token validation only; production uses OIDC discovery
# JWT_ISSUER: Must match the issuer in internal-auth-service
JWT_SECRET=
JWT_ISSUER=https://localhost:5001/

# ------------------------------------------------------------------------------
# AI / LLM — Groq
# ------------------------------------------------------------------------------
# Source: https://console.groq.com/keys
# Free tier: llama-3.1-8b-instant — 30 RPM, 14.4K RPD, 6K TPM
# If missing or unavailable, all AI features fall back to heuristic analysis.
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.1-8b-instant
