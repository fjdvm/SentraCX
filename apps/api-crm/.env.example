# ==============================================================================
# api-crm — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
# Source: Local PostgreSQL instance (v15+)
#   Install: https://www.postgresql.org/download/
#   Create DB: createdb sentracx_crm
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sentracx_crm
DATABASE_USER=postgres
DATABASE_PASSWORD=

# ------------------------------------------------------------------------------
# JWT / Auth (internal-auth-service)
# ------------------------------------------------------------------------------
# Source: internal-auth-service (OpenIddict OIDC provider) at https://localhost:5001
# JWT_AUTHORITY: The OIDC issuer URL (used for token validation via discovery doc)
# JWT_AUDIENCE: The resource identifier this API expects in tokens
JWT_AUTHORITY=https://localhost:5001
JWT_AUDIENCE=crms-client

# ------------------------------------------------------------------------------
# Redis (SignalR backplane + caching)
# ------------------------------------------------------------------------------
# Source: Local Redis instance
#   Install: sudo apt install redis-server (Linux) / brew install redis (macOS)
#   Verify: redis-cli ping → PONG
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# File Storage
# ------------------------------------------------------------------------------
# FILE_STORAGE_PROVIDER: "Local" (dev) or "S3" (production)
# S3 credentials only needed if FILE_STORAGE_PROVIDER=S3
FILE_STORAGE_PROVIDER=Local
AWS_S3_BUCKET=sentracx-uploads
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# AI-Analytics Service
# ------------------------------------------------------------------------------
# Used for calling api-ai-analytics on ticket creation (sentiment/categorization)
AI_ANALYTICS_BASE_URL=http://localhost:4005

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5005

# ------------------------------------------------------------------------------
# CORS Allowed Origins (comma-separated)
# ------------------------------------------------------------------------------
# web-crm (3005) and web-shop (3012) need access to this API (including SignalR ChatHub)
CORS_ORIGINS=https://localhost:3005,https://localhost:3012

# ------------------------------------------------------------------------------
# SMTP (Email Sending)
# ------------------------------------------------------------------------------
# Source: Brevo (formerly Sendinblue) SMTP relay
#   Sign up: https://www.brevo.com/
#   SMTP keys: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
