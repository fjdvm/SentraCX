# ==============================================================================
# web-crm — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# NextAuth.js v5
# ------------------------------------------------------------------------------
# AUTH_SECRET: Generate with: npx auth secret (or openssl rand -base64 32)
# AUTH_URL: The canonical URL of this app (must match OIDC redirect URI)
AUTH_SECRET=
AUTH_URL=https://localhost:3005

# ------------------------------------------------------------------------------
# OIDC Provider (internal-auth-service)
# ------------------------------------------------------------------------------
# Source: internal-auth-service seeder (DbSeeder.cs)
# Client registered as "crms-client" with redirect to https://localhost:3005
AUTH_CRMS_CLIENT_ID=crms-client
AUTH_CRMS_CLIENT_SECRET=crms-secret
AUTH_ISSUER=https://localhost:5001/

# ------------------------------------------------------------------------------
# API Backend Services
# ------------------------------------------------------------------------------
# CRM API (.NET) — used by server components and API routes
NEXT_PUBLIC_CRM_API_URL=https://localhost:5005

# AI-Analytics API (FastAPI) — used for dashboard, forecasting, customer insights
NEXT_PUBLIC_AI_API_URL=http://localhost:4005

# ------------------------------------------------------------------------------
# HTTPS Dev Cert (Linux only)
# ------------------------------------------------------------------------------
# Set automatically by scripts/trust-dev-cert.sh — uncomment if needed manually
# NODE_EXTRA_CA_CERTS=~/.aspnet/dev-certs/https-dev-cert.pem
